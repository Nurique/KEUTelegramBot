# Токен от @BotFather
BOT_TOKEN=
# Пароль для входа в админку
ADMIN_PASSWORD=
# Случайная строка ≥16 символов: openssl rand -hex 32
SESSION_SECRET=
# Необязательно: путь к файлу SQLite (по умолчанию ./data/bot.db)
# DATABASE_PATH=
# Необязательно: false, если админка открыта по HTTP без HTTPS-прокси (не рекомендуется)
# COOKIE_SECURE=false
