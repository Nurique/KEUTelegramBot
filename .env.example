# Токен от @BotFather
BOT_TOKEN=
# Пароль для входа в админку
ADMIN_PASSWORD=
# Случайная строка ≥16 символов: openssl rand -hex 32
SESSION_SECRET=
# Необязательно: путь к файлу SQLite (по умолчанию ./data/bot.db)
# DATABASE_PATH=
# Необязательно: false, если админка открыта по HTTP без HTTPS-прокси (не рекомендуется)
# COOKIE_SECURE=false

# --- Docker ---
# Порт админки на сервере (внутри контейнера всегда 3000)
# ADMIN_PORT=3000
# Адрес: 127.0.0.1 — только через reverse proxy (рекомендуется); 0.0.0.0 — открыть наружу
# ADMIN_BIND=127.0.0.1
